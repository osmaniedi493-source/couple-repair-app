LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_PROVIDER=openai-compatible
# Vision-capable model used only for transcribing imported chat screenshots
# (app/api/mediation/transcribe). Defaults to deepseek-v4-flash-vision-exp.
LLM_VISION_MODEL=deepseek-v4-flash-vision-exp

# Postgres connection string. When you provision a database via Vercel's
# Storage tab (Neon), running `vercel env pull .env.local` after linking the
# project will fill this in automatically — you shouldn't need to paste it
# by hand. Run `pnpm run db:migrate` once after this is set to create tables.
POSTGRES_URL=postgres://user:password@host/dbname?sslmode=require
